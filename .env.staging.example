# Variáveis de ambiente para build de staging.
# Copie este arquivo para .env.staging, preencha com a URL real de staging e NÃO versione.

# URL pública de staging — substituir pela URL real após escolher o provedor.
# Exemplo Vercel:   https://affetto-lavanderia.vercel.app
# Exemplo Netlify:  https://affetto-lavanderia.netlify.app
# Exemplo custom:   https://staging.affettolavanderia.com.br
SITE_URL=https://staging.affettolavanderia.com.br

# Telefone WhatsApp oficial — não alterar.
WHATSAPP_PHONE=5547997655025

# Tracking desativado em staging.
ENABLE_TRACKING=false

# IDs vazios em staging — não inserir IDs de produção.
GTM_ID=
GA4_ID=
META_PIXEL_ID=

# Ambiente.
APP_ENV=staging
